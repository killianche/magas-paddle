{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": { "resourceClass": "m-medium" }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "appleTeamId": "SGS6KFDCD4",
        "ascApiKeyPath": "../secrets/AuthKey.p8",
        "ascApiKeyIssuerId": "ЗАПОЛНИТЬ_ISSUER_ID_НОВОГО_КЛЮЧА",
        "ascApiKeyId": "ЗАПОЛНИТЬ_KEY_ID_НОВОГО_КЛЮЧА"
      }
    }
  }
}
