{
  "expo": {
    "name": "Magas Padel",
    "slug": "magas-padel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ru.padelmagas.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Magas Padel",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ru.padelmagas.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B0F0C"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "scheme": "magaspadel",
    "backgroundColor": "#0B0F0C",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0B0F0C",
      "resizeMode": "contain"
    },
    "experiments": {
      "baseUrl": "/v1"
    },
    "extra": {
      "apiUrl": "https://padel.217-114-8-196.sslip.io/api"
    }
  }
}