{
  "expo": {
    "name": "Magas Padel",
    "slug": "magas-padel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ru.padelmagas.app",
      "buildNumber": "10",
      "infoPlist": {
        "CFBundleDisplayName": "Magas Padel",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ru.padelmagas.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0B0F0C"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F0C",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0F0C"
          }
        }
      ]
    ],
    "scheme": "magaspadel",
    "backgroundColor": "#0B0F0C",
    "newArchEnabled": true,
    "experiments": {
      "baseUrl": "/v1"
    },
    "extra": {
      "apiUrl": "https://padel.217-114-8-196.sslip.io/api"
    }
  }
}
