generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
model admins {
  id            BigInt           @id @default(autoincrement())
  login         String           @unique
  name          String
  password_hash String
  role          String           @default("staff")
  perms         String[]
  is_active     Boolean          @default(true)
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  last_login_at DateTime?        @db.Timestamptz(6)
  sessions      admin_sessions[]
  log           admin_log[]
}

model admin_sessions {
  token_hash String   @id
  admin_id   BigInt
  created_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)
  last_seen  DateTime @default(now()) @db.Timestamptz(6)
  admins     admins   @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id], map: "admin_sessions_admin")
}

model admin_log {
  id         BigInt   @id @default(autoincrement())
  admin_id   BigInt?
  admin_name String
  action     String
  details    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  admins     admins?  @relation(fields: [admin_id], references: [id], onDelete: SetNull)

  @@index([created_at], map: "admin_log_time")
}

model price_rules {
  id         BigInt   @id @default(autoincrement())
  court_id   String?
  days       Int[]    @db.SmallInt
  from_hour  Int      @db.SmallInt
  to_hour    Int      @db.SmallInt
  price      Int
  note       String?
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  courts     courts?  @relation(fields: [court_id], references: [id], onDelete: Cascade)

  @@index([sort_order, id], map: "price_rules_order")
}

model payments {
  id         BigInt   @id @default(autoincrement())
  booking_id BigInt
  amount     Int
  method     String
  kind       String   @default("payment")
  receipt    String?
  note       String?
  admin_id   BigInt?
  admin_name String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  bookings   bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([booking_id], map: "payments_booking")
  @@index([created_at], map: "payments_time")
}

model settings {
  id            Int      @id @default(1) @db.SmallInt
  open_hour     Int      @db.SmallInt
  close_hour    Int      @db.SmallInt
  morning_until Int      @db.SmallInt
  max_hours     Int      @db.SmallInt
  cancel_hours  Int      @db.SmallInt
  hold_minutes  Int      @db.SmallInt
  phone         String?
  whatsapp      String?
  address       String?
  map_url       String?
  instagram        String?
  prepay_percent   Int      @default(50) @db.SmallInt
  late_minutes     Int      @default(15) @db.SmallInt
  rentals_text     String?
  show_tournaments Boolean  @default(true)
  show_football    Boolean  @default(true)
  wa_template      String?
  booking_note     String?
  hero_url         String?
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
}

model notifications {
  id         BigInt    @id @default(autoincrement())
  client_id  BigInt?
  kind       String    @default("manual")
  title      String
  body       String
  booking_id BigInt?
  created_by String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  read_at    DateTime? @db.Timestamptz(6)
  clients    clients?  @relation(fields: [client_id], references: [id], onDelete: Cascade)
  bookings   bookings? @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  reads      notification_reads[]

  @@index([client_id, created_at], map: "notifications_client")
}

model notification_reads {
  notification_id BigInt
  client_id       BigInt
  read_at         DateTime      @default(now()) @db.Timestamptz(6)
  notifications   notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  clients         clients       @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@id([notification_id, client_id])
}

model bookings {
  notifications notifications[]
  id         BigInt         @id @default(autoincrement())
  court_id   String
  client_id  BigInt?
  starts_at  DateTime       @db.Timestamptz(6)
  ends_at    DateTime       @db.Timestamptz(6)
  status     booking_status @default(pending)
  price      Int
  source     String         @default("app")
  comment    String?
  guest_name String?
  status_at  DateTime?      @db.Timestamptz(6)
  status_by  String?
  hold_until DateTime?      @db.Timestamptz(6)
  players    Int?           @db.SmallInt
  discount   Int            @default(0)
  discount_reason String?
  created_by String?
  tournament_id BigInt?
  created_at DateTime       @default(now()) @db.Timestamptz(6)
  updated_at DateTime       @default(now()) @db.Timestamptz(6)
  clients    clients?       @relation(fields: [client_id], references: [id], onUpdate: NoAction)
  courts     courts         @relation(fields: [court_id], references: [id], onUpdate: NoAction)
  tournaments tournaments?  @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  payments   payments[]

  @@index([client_id], map: "bookings_client")
  @@index([court_id, starts_at], map: "bookings_court_time")
  @@index([starts_at], map: "bookings_starts")
  @@index([tournament_id], map: "bookings_tournament")
}

model clients {
  id                 BigInt               @id @default(autoincrement())
  phone              String               @unique
  name               String
  surname            String?
  no_shows           Int                  @default(0)
  cancels            Int                  @default(0)
  note               String?
  whatsapp           String?
  pass_hash          String?
  pass_at            DateTime?            @db.Timestamptz(6)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  bookings           bookings[]
  tournament_entries tournament_entries[]
  client_sessions    client_sessions[]
  notifications      notifications[]
  notification_reads notification_reads[]
}

model client_sessions {
  token_hash String   @id
  client_id  BigInt
  created_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)
  last_seen  DateTime @default(now()) @db.Timestamptz(6)
  clients    clients  @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id], map: "client_sessions_client")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model courts {
  id            String     @id
  name          String
  is_football   Boolean    @default(false)
  price_morning  Int
  price_standard Int
  is_active     Boolean    @default(true)
  closed_until  DateTime?  @db.Timestamptz(6)
  closed_reason String?
  description   String?
  color         String?
  tags          String[]   @default([])
  sort_order    Int        @default(0)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  bookings      bookings[]
  price_rules   price_rules[]
  court_photos  court_photos[]
}

model tournament_entries {
  id            BigInt      @id @default(autoincrement())
  tournament_id BigInt
  client_id     BigInt
  paid_amount   Int         @default(0)
  paid_method   String?
  paid_at       DateTime?   @db.Timestamptz(6)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  clients       clients     @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tournaments   tournaments @relation(fields: [tournament_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tournament_id, client_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tournaments {
  id                 BigInt               @id @default(autoincrement())
  name               String
  starts_at          DateTime             @db.Timestamptz(6)
  format             String
  fee                Int
  seats              Int
  state              tournament_state     @default(soon)
  hours              Int                  @default(3) @db.SmallInt
  court_ids          String[]
  cover_url          String?
  result_text        String?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  tournament_entries tournament_entries[]
  bookings           bookings[]
}

model expenses {
  id         BigInt   @id @default(autoincrement())
  month      DateTime @db.Date
  category   String
  amount     Int
  note       String?
  admin_id   BigInt?
  admin_name String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([month], map: "expenses_month")
}

model sales {
  id         BigInt   @id @default(autoincrement())
  day        DateTime @db.Date
  category   String
  amount     Int
  method     String
  qty        Int      @default(1) @db.SmallInt
  note       String?
  admin_id   BigInt?
  admin_name String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([day], map: "sales_day")
}

enum booking_status {
  pending
  confirmed
  cancelled
  no_show
  done
  /// Заявку не подтвердили вовремя — время снова свободно
  expired
}

enum tournament_state {
  soon
  open
  done
}

model court_photos {
  id         BigInt   @id @default(autoincrement())
  court_id   String
  url        String
  sort       Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  courts     courts   @relation(fields: [court_id], references: [id], onDelete: Cascade)

  @@index([court_id, sort], map: "court_photos_court")
}
